cmake_minimum_required(VERSION 3.8)
project(beefast_virual_wall_service)

if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  add_compile_options(-Wall -Wextra -Wpedantic)
endif()

# find dependencies
find_package(ament_cmake REQUIRED)
find_package(rclcpp REQUIRED)
find_package(std_msgs REQUIRED)
find_package(sensor_msgs REQUIRED)
find_package(visualization_msgs REQUIRED)
find_package(nav2_msgs REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(map_msgs REQUIRED)
find_package(nav2_costmap_2d REQUIRED)
find_package(nav2_util REQUIRED)
find_package(rclcpp_lifecycle REQUIRED)
find_package(beefast_filter_mask REQUIRED)
find_package(beefast_utils REQUIRED)
find_package(nav2_map_server REQUIRED)

include_directories(
  include
)

set(dependencies
  rclcpp
  std_msgs
  sensor_msgs
  visualization_msgs
  nav2_msgs
  geometry_msgs
  map_msgs
  nav2_costmap_2d
  nav2_util
  rclcpp_lifecycle
  beefast_filter_mask
  beefast_utils
  nav2_map_server
)

add_executable(virual_wall_server 
  src/virual_wall_server.cpp
  src/main.cpp
)
ament_target_dependencies(virual_wall_server ${dependencies})


install(TARGETS virual_wall_server
  RUNTIME DESTINATION lib/${PROJECT_NAME}
)

ament_package()
